{
  "name": "personal-site",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "npm run blog:update-manifest",
    "build": "ng build",
    "prebuild:prod": "npm run blog:update-manifest",
    "build:prod": "ng build --configuration production --base-href / && cp dist/personal-site/browser/index.html dist/personal-site/browser/404.html",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "blog:update-manifest": "node npm-functions/generate-blog-manifest-ts.js",
    "supabase:deploy:fn": "node npm-functions/deploy-supabase-fn.js",
    "supabase:serve:fn": "supabase functions serve --env-file .env.local --no-verify-jwt"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.2",
    "@angular/common": "^22.1.2",
    "@angular/compiler": "^22.1.2",
    "@angular/core": "^22.1.2",
    "@angular/forms": "^22.1.2",
    "@angular/platform-browser": "^22.1.2",
    "@angular/platform-browser-dynamic": "^22.1.2",
    "@angular/router": "^22.1.2",
    "@fontsource/inter": "^5.2.6",
    "@openng/icons": "^1.0.0",
    "@openng/optimus-ui": "^2.0.0",
    "@openng/optimus-ui-themes": "^2.0.0",
    "@supabase/supabase-js": "^2.110.8",
    "emoji-toolkit": "^9.0.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.47",
    "marked": "^18.0.7",
    "marked-katex-extension": "^5.1.11",
    "matter-js": "^0.20.0",
    "ngx-markdown": "^22.0.0",
    "prismjs": "^1.30.0",
    "reading-time-estimator": "^1.14.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.2",
    "@types/matter-js": "^0.19.8",
    "angular-eslint": "22.1.0",
    "eslint": "^9.28.0",
    "jsdom": "^29.1.1",
    "supabase": "^2.23.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.33.1",
    "vitest": "^4.1.10"
  }
}
